@model UserEditViewModel
@{ ViewData["Title"]="Edit user"; }
<h1 class="h2">Edit user: @Model.Name</h1>
<form asp-action="EditUser" asp-route-id="@Model.Id" method="post" class="card card-body">
 <input asp-for="Id" type="hidden" /><input asp-for="Name" type="hidden" /><div asp-validation-summary="All" class="text-danger"></div>
 <div class="mb-3"><label asp-for="Role" class="form-label"></label><select asp-for="Role" class="form-select"><option>Customer</option><option>DiveCenter</option><option>Admin</option></select></div>
 <div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Active</label></div>
 <button class="btn btn-primary">Save</button>
</form>
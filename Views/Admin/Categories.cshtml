@model List<ActivityCategory>
@{ ViewData["Title"]="Admin · Categories"; }
<h1 class="h2">Activity categories</h1><a class="btn btn-primary mb-3" asp-action="EditCategory">Add category</a>
<div class="table-responsive"><table class="table"><thead><tr><th>Name</th><th>Slug</th><th>Status</th><th></th></tr></thead><tbody>
@foreach(var category in Model) { <tr><td>@category.Name</td><td>@category.Slug</td><td>@(category.IsActive ? "Active" : "Inactive")</td><td><a asp-action="EditCategory" asp-route-id="@category.Id">Edit</a></td></tr> }
</tbody></table></div>
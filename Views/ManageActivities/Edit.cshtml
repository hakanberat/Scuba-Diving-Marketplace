@model ActivityEditViewModel
@{ var action=Model.Id==0 ? "Create" : "Edit"; ViewData["Title"]=action; }
<h1 class="h2">@action</h1>
@if(Model.Id > 0) { <a class="btn btn-outline-primary mb-3" asp-controller="Photos" asp-action="Activity" asp-route-id="@Model.Id">Manage photos</a> }
else { <p class="text-muted">Save the activity first, then add gallery photos.</p> }
<form asp-action="@action" asp-route-id="@Model.Id" method="post" class="card card-body">
<input asp-for="Id" type="hidden" /><div class="mb-3"><label asp-for="MapLocation" class="form-label">Google Maps location</label><input asp-for="MapLocation" class="form-control" placeholder="Full address, place name or latitude, longitude" /><span asp-validation-for="MapLocation" class="text-danger"></span><small class="text-muted">Enter a precise address or coordinates, e.g. 35.123456, 33.987654. Leave empty to use the existing address/location and city.</small></div><div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="DiveCenterId" class="form-label">Dive center</label><select asp-for="DiveCenterId" class="form-select"><option value="">Select center</option>@foreach(var center in Model.Centers) { <option value="@center.Id">@center.Name</option> }</select></div><div class="mb-3"><label asp-for="ActivityCategoryId" class="form-label">Category</label><select asp-for="ActivityCategoryId" class="form-select"><option value="">Select category</option>@foreach(var category in Model.Categories) { <option value="@category.Id">@category.Name @(category.IsActive ? "" : "(inactive)")</option> }</select></div><div class="mb-3"><label asp-for="Name" class="form-label">Name</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="ShortDescription" class="form-label">Short Description</label><input asp-for="ShortDescription" class="form-control" /><span asp-validation-for="ShortDescription" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Description" class="form-label">Description</label><textarea asp-for="Description" class="form-control" rows="4"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Country" class="form-label">Country</label><select asp-for="Country" asp-items="CountryOptions.Get(Model.Country)" class="form-select"><option value="">Select country</option></select><span asp-validation-for="Country" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="City" class="form-label">City</label><input asp-for="City" class="form-control" /><span asp-validation-for="City" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Location" class="form-label">Location</label><input asp-for="Location" class="form-control" /><span asp-validation-for="Location" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Price" class="form-label">Price</label><input asp-for="Price" class="form-control" type="number" step="0.01" /><span asp-validation-for="Price" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Duration" class="form-label">Duration</label><input asp-for="Duration" class="form-control" /><span asp-validation-for="Duration" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="MinimumAge" class="form-label">Minimum Age</label><input asp-for="MinimumAge" class="form-control" /><span asp-validation-for="MinimumAge" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="MinimumCertification" class="form-label">Minimum Certification</label><input asp-for="MinimumCertification" class="form-control" /><span asp-validation-for="MinimumCertification" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="MaxParticipants" class="form-label">Max Participants</label><input asp-for="MaxParticipants" class="form-control" /><span asp-validation-for="MaxParticipants" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Included" class="form-label">Included</label><textarea asp-for="Included" class="form-control" rows="4"></textarea><span asp-validation-for="Included" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="NotIncluded" class="form-label">Not Included</label><textarea asp-for="NotIncluded" class="form-control" rows="4"></textarea><span asp-validation-for="NotIncluded" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Requirements" class="form-label">Requirements</label><textarea asp-for="Requirements" class="form-control" rows="4"></textarea><span asp-validation-for="Requirements" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="MainImageUrl" class="form-label">Main Image Url</label><input asp-for="MainImageUrl" class="form-control" /><span asp-validation-for="MainImageUrl" class="text-danger"></span></div>
<div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Is Active</label></div>
<div class="mb-3"><label asp-for="CurrencyCode" class="form-label">Currency</label><select asp-for="CurrencyCode" class="form-select">@foreach(var currency in new[]{"TRY","USD","EUR","GBP"}) { <option value="@currency">@currency</option> }</select></div><div><button class="btn btn-primary">Save</button><a asp-action="Index" class="btn btn-outline-secondary ms-2">Back</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

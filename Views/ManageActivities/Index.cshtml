@model List<DiveActivity>
@{ ViewData["Title"]="Manage activities"; }
<h1 class="h2">Manage activities</h1><a class="btn btn-primary mb-3" asp-action="Create">Add activity</a>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Activity</th><th>Center</th><th>Price</th><th>Status</th><th>Actions</th></tr></thead><tbody>
@foreach(var item in Model) {
 <tr><td>@item.Name</td><td>@item.DiveCenterName</td><td>@item.Price.ToString("N2") @item.CurrencyCode</td><td>@(item.IsActive ? "Active" : "Inactive")</td><td>
 <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a><a class="btn btn-sm btn-outline-secondary" asp-controller="Photos" asp-action="Activity" asp-route-id="@item.Id">Manage photos</a>
 <form asp-action="SetActive" method="post" class="d-inline" onsubmit="return confirm('Change activity availability?');"><input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="active" value="@((!item.IsActive).ToString())" /><button class="btn btn-sm btn-outline-secondary">@(item.IsActive ? "Deactivate" : "Activate")</button></form>
 </td></tr>
}
</tbody></table></div>
@if(!Model.Any()) { <p>No activities yet. Create a dive center profile before adding activities.</p> }
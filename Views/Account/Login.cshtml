@model LoginViewModel
@{ ViewData["Title"]="Log in"; }
<section class="account-shell">
 <div class="account-story"><p class="eyebrow">A whole world below</p><h2>The next chapter<br />starts underwater.</h2><p>Return to your plans. Discover a new place.<br />Find your next unforgettable dive.</p><a asp-controller="Activities" asp-action="Index" class="section-link">Explore experiences &rarr;</a></div>
 <div class="account-form"><p class="eyebrow">Your DiveMarketplace account</p><h1>Welcome back.</h1><p class="text-muted">Log in to plan your next underwater adventure.</p>
 <form asp-action="Login" method="post">
  <input asp-for="ReturnUrl" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
  <div class="mb-4"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="username" /><span asp-validation-for="Email" class="text-danger"></span></div>
  <div class="mb-4"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="current-password" /><span asp-validation-for="Password" class="text-danger"></span></div>
  <button class="btn btn-primary w-100">Log in &rarr;</button>
 </form><p class="account-switch">New here? <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a></p>
 </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

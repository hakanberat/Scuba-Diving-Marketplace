@{ ViewData["Title"]="Account created"; }
<div class="row justify-content-center">
 <div class="col-md-7 col-lg-6">
  <div class="card card-body text-center p-4 p-md-5">
   <p class="text-success fw-semibold mb-2">Registration successful</p>
   <h1 class="h2">Your account has been created</h1>
   <p class="text-muted mb-4">You are now signed in and ready to book your next diving adventure.</p>
   <div class="d-flex flex-wrap justify-content-center gap-2">
    <a class="btn btn-primary" href="@ViewData["ReturnUrl"]">Continue</a>
    <a class="btn btn-outline-secondary" asp-action="Profile">View your profile</a>
   </div>
  </div>
 </div>
</div>

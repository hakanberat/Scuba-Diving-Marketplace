@model ProfileViewModel
@{ ViewData["Title"]="My profile"; }
<h1 class="h2">My profile</h1>
<p class="text-muted">Update your personal contact details. Existing reservations keep the contact details supplied when booking.</p>
<form asp-action="Profile" method="post" class="card card-body">
 <div asp-validation-summary="All" class="text-danger"></div>
 <div class="row g-3">
  <div class="col-md-6"><label asp-for="FirstName" class="form-label">First name</label><input asp-for="FirstName" class="form-control" autocomplete="given-name" /></div>
  <div class="col-md-6"><label asp-for="LastName" class="form-label">Last name</label><input asp-for="LastName" class="form-control" autocomplete="family-name" /></div>
  <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" /></div>
  <div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" autocomplete="tel" /></div>
 </div>
 <div class="mt-3"><button class="btn btn-primary">Save profile</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

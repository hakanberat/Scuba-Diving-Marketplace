@model DiveCenterDetailsViewModel
@{ ViewData["Title"]=Model.Center.Name; var center=Model.Center; }
<nav class="breadcrumb-nav" aria-label="Breadcrumb"><a asp-action="Index">Dive centers</a><span aria-hidden="true">/</span><span>@center.City, @center.Country</span></nav>
@if(Model.Photos.Any()) { <partial name="_PhotoGallery" model="Model.Photos" /> }
else if(!string.IsNullOrWhiteSpace(center.CoverPhotoUrl)) { <img src="@center.CoverPhotoUrl" alt="@center.Name in @center.City" class="detail-cover" fetchpriority="high" /> }
else { <div class="detail-cover center-cover media-fallback"><span>@center.City, @center.Country</span></div> }
<header class="center-identity">
 @if(!string.IsNullOrWhiteSpace(center.LogoUrl)) { <img src="@center.LogoUrl" alt="@(center.Name) logo" class="center-identity-logo" /> }
 <div><p class="eyebrow">Your local dive experts &middot; @center.City, @center.Country</p><h1>@center.Name</h1><a class="section-link" href="#center-experiences">Explore their experiences &darr;</a></div>
</header>
<div class="row g-5">
 <div class="col-lg-8"><section class="editorial-section"><h2>Get to know @center.Name</h2><p class="preserve-lines">@center.Description</p></section>
 <partial name="_LocationMap" model="@(new MapViewModel { Name=center.Name, Location=string.IsNullOrWhiteSpace(center.MapLocation) ? MapViewModel.Resolve(center.Address,center.City,center.Country) : center.MapLocation })" />
 </div>
 <aside class="col-lg-4"><section class="contact-panel"><p class="eyebrow">Plan your visit</p><h2 class="h4">Let's talk diving</h2><p>Contact the center for local advice and help preparing your visit.</p>
 @if(!string.IsNullOrWhiteSpace(center.Address)) { <div class="contact-item"><span>Find us</span><p>@center.Address<br />@center.City, @center.Country</p></div> }
 @if(!string.IsNullOrWhiteSpace(center.Phone)) { <div class="contact-item"><span>Call the center</span><a href="tel:@center.Phone">@center.Phone</a></div> }
 @if(!string.IsNullOrWhiteSpace(center.Email)) { <div class="contact-item"><span>Email the center</span><a href="mailto:@center.Email">@center.Email</a></div> }
 @if(!string.IsNullOrWhiteSpace(center.Website)) {
  var website=center.Website.StartsWith("https://",StringComparison.OrdinalIgnoreCase) || center.Website.StartsWith("http://",StringComparison.OrdinalIgnoreCase) ? center.Website : "https://"+center.Website;
  <div class="contact-item"><span>Online</span><a href="@website" target="_blank" rel="noopener noreferrer">Visit their website &nearr;</a></div>
 }
 </section></aside>
</div>
<section class="discovery-section instructor-section">
 <div class="section-heading"><div><p class="eyebrow">Shared passion. Local knowledge.</p><h2>Meet the instructors</h2></div></div>
 <div class="row g-4">
 @foreach(var instructor in Model.Instructors) {
  <div class="col-sm-6 col-lg-4"><article class="instructor-card h-100">
   @if(!string.IsNullOrWhiteSpace(instructor.PhotoUrl)) { <img src="@instructor.PhotoUrl" alt="@instructor.FirstName @instructor.LastName" class="instructor-photo" loading="lazy" /> }
   <div><h3 class="h4">@instructor.FirstName @instructor.LastName</h3><p class="eyebrow">@instructor.CertificationAgency</p>@if(!string.IsNullOrWhiteSpace(instructor.InstructorNumber)) { <p class="small text-muted">Instructor @instructor.InstructorNumber</p> }<p class="preserve-lines">@instructor.Bio</p></div>
  </article></div>
 }
 </div>
 @if(!Model.Instructors.Any()) { <p class="text-muted">The center hasn't added instructor profiles yet. Contact them to meet the team.</p> }
</section>
<section class="discovery-section" id="center-experiences"><div class="section-heading"><div><p class="eyebrow">Dive with @center.Name</p><h2>Find your next experience</h2></div></div><partial name="_ActivityCards" model="Model.Activities" /></section>

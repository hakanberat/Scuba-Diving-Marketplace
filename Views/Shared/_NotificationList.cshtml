@model List<Notification>
@foreach(var item in Model) {
 <article class="card card-body mb-3 @(item.IsRead ? "" : "border-danger notification-unread")"><div class="d-flex justify-content-between gap-3"><h2 class="h5">@item.Title</h2>@if(!item.IsRead) { <span class="badge text-bg-danger">New</span> }</div><p>@item.Message</p><small class="text-muted mb-3">@item.CreatedAt.ToString("dd MMM yyyy HH:mm") UTC</small><div class="d-flex flex-wrap gap-2"><a class="btn btn-primary btn-sm" href="@item.LinkUrl">View details</a>@if(!item.IsRead) { <form asp-action="MarkRead" method="post"><input name="id" value="@item.Id" type="hidden" /><button class="btn btn-outline-secondary btn-sm">Mark read</button></form> }</div></article>
}
@if(!Model.Any()) { <div class="empty-state">You have no notifications yet.</div> }

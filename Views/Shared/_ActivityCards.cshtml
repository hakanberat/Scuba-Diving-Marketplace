@model IEnumerable<DiveActivity>
<div class="row g-4">
@foreach(var activity in Model)
{
 <div class="col-sm-6 col-lg-4">
  <article class="card experience-card h-100">
   <div class="experience-media">
   @if(!string.IsNullOrWhiteSpace(activity.DisplayImageUrl))
   { <img src="@activity.DisplayImageUrl" alt="@activity.Name" class="card-img-top activity-image" loading="lazy" /> }
   else { <div class="image-placeholder"><span aria-hidden="true">&sim;</span><span>Discover beneath the surface</span></div> }
   <span class="experience-category">@activity.CategoryName</span>
   </div>
   <div class="card-body">
    <p class="card-location">@activity.City<span>&middot;</span>@activity.Country</p>
    <h3 class="h5"><a class="stretched-link text-decoration-none" asp-controller="Activities" asp-action="Details" asp-route-id="@activity.Id">@activity.Name</a></h3>
    <p class="card-description">@activity.ShortDescription</p>
    @if(!string.IsNullOrWhiteSpace(activity.Duration)) { <p class="card-duration">@activity.Duration</p> }
    <p class="center-credit">By @activity.DiveCenterName</p>
   </div>
   <div class="card-footer"><div><span class="price-label">Per participant</span><strong>@activity.Price.ToString("N2") <small>@activity.CurrencyCode</small></strong></div><span class="card-arrow" aria-hidden="true">&nearr;</span></div>
  </article>
 </div>
}
</div>
@if(!Model.Any()) { <div class="empty-state"><h3 class="h5">Your next adventure is on its way</h3><p>No activities found. Try different filters or check back soon.</p></div> }

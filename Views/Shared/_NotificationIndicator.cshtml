@model NotificationIndicatorViewModel
<a id="notification-indicator" class="btn btn-sm notification-indicator @(Model.UnreadCount > 0 ? "btn-outline-danger has-unread" : "btn-outline-primary")"
   asp-controller="Notifications" asp-action="Index" data-user-id="@Model.UserId" data-latest-id="@Model.LatestUnreadId"
   data-unread-count="@Model.UnreadCount" data-pending-applications="@Model.PendingApplications" data-refresh-url="@Url.Action("Indicator", "Notifications")">
    <svg class="notification-bell" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" /><path d="M10 21h4" /></svg> Notifications
    <span class="badge @(Model.UnreadCount > 0 ? "text-bg-danger" : "text-bg-secondary")" aria-live="polite">@Model.UnreadCount</span>
</a>
